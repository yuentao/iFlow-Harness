{
  "description": "Thinking model rules config template",
  "version": 1,
  "models": [
    {
      "pattern": "glm-",
      "supportsThinking": true,
      "thinkingRequest": {
        "delete": ["thinking"],
        "set": {
          "temperature":1,
          "top_p":0.95,
          "reasoning_effort":"max",
          "enable_thinking": false
        }
      },
      "nonThinkingRequest": {
        "delete": ["thinking"],
        "set": {
          "temperature":1,
          "top_p":0.95,
          "reasoning_effort":"max",
          "enable_thinking": false
        }
      }
    },
    {
      "pattern": "qwen3.8-",
      "supportsThinking": true,
      "maxThinkingTokens": 20000,
      "thinkingRequest": {
        "set": {
          "enable_thinking": true
        }
      },
      "nonThinkingRequest": {
        "delete": ["enable_thinking"]
      }
    },
    {
      "pattern": "Qwen3.8-",
      "supportsThinking": true,
      "maxThinkingTokens": 20000,
      "thinkingRequest": {
        "set": {
          "enable_thinking": true
        }
      },
      "nonThinkingRequest": {
        "delete": ["enable_thinking"]
      }
    },
    {
      "pattern": "^claude-",
      "supportsThinking": true,
      "supportedReasoningLevels": ["low", "medium", "high"],
      "maxThinkingTokens": 20000,
      "thinkingRequest": {
        "setNested": {
          "chat_template_kwargs.enable_thinking": true
        }
      }
    },
    {
      "pattern": "reasoning",
      "supportsThinking": true,
      "supportedReasoningLevels": ["low", "medium"],
      "maxThinkingTokens": 10000,
      "thinkingRequest": {
        "setConditional": [
          {
            "when": {
              "reasoningLevel": {
                "ne": "low"
              }
            },
            "set": {
              "reasoning": true
            }
          }
        ]
      },
      "nonThinkingRequest": {
        "delete": ["reasoning"]
      }
    },
    {
      "pattern": "thinking",
      "supportsThinking": true,
      "supportedReasoningLevels": ["low", "medium", "high"],
      "maxThinkingTokens": 15000,
      "thinkingRequest": {
        "set": {
          "thinking_mode": true
        }
      },
      "nonThinkingRequest": {
        "delete": ["thinking_mode"]
      }
    },
    {
      "pattern": "deepseek-v4-",
      "supportsThinking": true,
      "supportedReasoningLevels": ["high"],
      "maxThinkingTokens": 65536,
      "thinkingRequest": {
        "setNested": {
          "thinking.type": "enabled",
          "thinking.reasoning_effort": "max"
        }
      },
      "nonThinkingRequest": {
        "setNested": {
          "thinking.type": "disabled"
        }
      }
    }
  ],
  "modelAliases": {
    "astron-code-latest": "glm-5.1"
  }
}
