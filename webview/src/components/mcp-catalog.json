[
  {
    "id": "filesystem",
    "name": "filesystem",
    "category": "文件与开发",
    "description": "在显式授权的目录范围内读取、写入和搜索文件。",
    "source": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
    "template": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${allowed_paths}"
      ]
    },
    "fields": [
      {
        "key": "allowed_paths",
        "label": "允许访问的目录",
        "placeholder": "C:\\Projects\\my-app",
        "required": true
      }
    ]
  },
  {
    "id": "git",
    "name": "git",
    "category": "文件与开发",
    "description": "读取、搜索和操作指定 Git 仓库。",
    "source": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
    "template": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "${repository_path}"
      ]
    },
    "fields": [
      {
        "key": "repository_path",
        "label": "Git 仓库目录",
        "placeholder": "C:\\Projects\\my-app",
        "required": true
      }
    ]
  },
