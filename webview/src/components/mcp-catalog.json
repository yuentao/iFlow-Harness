  {
    "id": "mongodb",
    "name": "mongodb",
    "category": "数据库与存储",
    "description": "连接 MongoDB；模板启用只读模式。",
    "source": "https://github.com/mongodb-js/mongodb-mcp-server",
    "template": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@latest",
        "--readOnly"
      ],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "${MDB_MCP_CONNECTION_STRING}"
      }
    },
    "fields": [
      {
        "key": "MDB_MCP_CONNECTION_STRING",
        "label": "MongoDB connection string",
        "placeholder": "mongodb://localhost:27017/myDatabase",
        "required": true,
        "secret": true
      }
    ]
  },
  {
    "id": "tavily",
    "name": "tavily-mcp",
    "category": "网页与搜索",
    "description": "Tavily 网页搜索、提取和爬取工具。",
    "source": "https://github.com/tavily-ai/tavily-mcp",
    "template": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@latest"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "fields": [
      {
        "key": "TAVILY_API_KEY",
        "label": "Tavily API key",
        "placeholder": "API key",
        "required": true,
        "secret": true
      }
    ]
  },
  {
    "id": "qdrant",
    "name": "qdrant",
    "category": "数据库与存储",
    "description": "向量检索和语义记忆；模板使用 Qdrant Cloud。",
    "source": "https://github.com/qdrant/mcp-server-qdrant",
    "template": {
      "command": "uvx",
      "args": [
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "${QDRANT_URL}",
        "QDRANT_API_KEY": "${QDRANT_API_KEY}",
        "COLLECTION_NAME": "${COLLECTION_NAME}",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      }
    },
    "fields": [
      {
        "key": "QDRANT_URL",
        "label": "Qdrant URL",
        "placeholder": "https://…:6333",
        "required": true
      },
      {
        "key": "QDRANT_API_KEY",
        "label": "Qdrant API key",
        "placeholder": "输入 API key",
        "required": true,
        "secret": true
      },
      {
        "key": "COLLECTION_NAME",
        "label": "Collection 名称",
        "placeholder": "my-collection",
        "required": true
      }
    ]
  },
  {
    "id": "dbhub",
    "name": "dbhub",
    "category": "数据库与存储",
    "description": "通过 DBHub 连接兼容数据库；需提供 DSN。",
    "source": "https://github.com/bytebase/dbhub",
    "template": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--transport",
        "stdio",
        "--dsn",
        "${DATABASE_DSN}"
      ]
    },
    "fields": [
      {
        "key": "DATABASE_DSN",
        "label": "数据库 DSN",
        "placeholder": "postgres://user:password@localhost:5432/dbname",
        "required": true,
        "secret": true
      }
    ]
  },
  {
    "id": "redis",
    "name": "redis",
    "category": "数据库与存储",
    "description": "通过 Redis MCP Server 连接 Redis 数据库。",
    "source": "https://github.com/redis/mcp-redis",
    "template": {
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--url",
        "${REDIS_URL}"
      ]
    },
    "fields": [
      {
        "key": "REDIS_URL",
        "label": "Redis URL",
        "placeholder": "redis://localhost:6379/0",
        "required": true,
        "secret": true
      }
    ]
  },
  {
    "id": "elasticsearch",
    "name": "elasticsearch-mcp-server",
    "category": "数据库与存储",
    "description": "连接 Elasticsearch 集群并使用 API key 鉴权。",
    "source": "https://github.com/elastic/mcp-server-elasticsearch",
    "template": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ES_URL",
        "-e",
        "ES_API_KEY",
        "docker.elastic.co/mcp/elasticsearch",
        "stdio"
      ],
      "env": {
        "ES_URL": "${ES_URL}",
        "ES_API_KEY": "${ES_API_KEY}"
      }
    },
    "fields": [
      {
        "key": "ES_URL",
        "label": "Elasticsearch URL",
        "placeholder": "https://…",
        "required": true
      },
      {
        "key": "ES_API_KEY",
        "label": "Elasticsearch API key",
        "placeholder": "输入 API key",
        "required": true,
        "secret": true
      }
    ]
  }
]
