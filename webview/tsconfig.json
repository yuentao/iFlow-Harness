{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "noUnusedLocals": true,
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // ../shared is compiled wholesale, and the host-only prompt builders there
    // read templates through prompts/index.ts (node:fs). Types only — Vite
    // still bundles just the browser-side webview code.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "../shared"]
}
