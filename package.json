{
  "name": "iflow-harness",
  "displayName": "%iflow.displayName%",
  "description": "%iflow.description%",
  "version": "1.7.0",
  "type": "module",
  "publisher": "yuantao",
  "author": {
    "name": "yuantao",
    "email": "work@pandorastudio.cn"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuentao/iFlow-Harness.git"
  },
  "keywords": [
    "iflow",
    "ai",
    "agent",
    "acp",
    "chat"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "contributes": {
    "chatParticipants": [
      {
        "id": "iflow.agent",
        "name": "iflow",
        "fullName": "iFlow",
        "description": "%participant.description%",
        "isSticky": true,
        "commands": []
      }
    ],
    "commands": [
      {
        "command": "iflow.openPanel",
        "title": "%command.openPanel.title%",
        "category": "iFlow",
        "icon": "media/iflow-title.svg"
      },
      {
        "command": "iflow.newSession",
        "title": "%command.newSession.title%",
        "category": "iFlow"
      },
      {
        "command": "iflow.askSelection",
        "title": "%command.askSelection.title%",
        "category": "iFlow"
      },
      {
        "command": "iflow.addSelectionToContext",
        "title": "%command.addSelectionToContext.title%",
        "category": "iFlow"
      },
      {
        "command": "iflow.rememberSelection",
        "title": "%command.rememberSelection.title%",
        "category": "iFlow"
      },
      {
        "command": "iflow.restartCli",
        "title": "%command.restartCli.title%",
        "category": "iFlow"
      },
      {
        "command": "iflow.exportSessionMarkdown",
        "title": "%command.exportSessionMarkdown.title%",
        "category": "iFlow"
      },
      {
        "command": "iflow.exportSessionJson",
        "title": "%command.exportSessionJson.title%",
        "category": "iFlow"
      },
      {
        "command": "iflow.exportWireLog",
        "title": "%command.exportWireLog.title%",
        "category": "iFlow"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "iflow.openPanel",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "iflow.askSelection",
          "when": "editorHasSelection",
          "group": "9_iflow"
        },
        {
          "command": "iflow.addSelectionToContext",
          "when": "editorHasSelection",
          "group": "9_iflow"
        },
        {
          "command": "iflow.rememberSelection",
          "when": "editorHasSelection",
          "group": "9_iflow"
        }
      ]
    },
    "configuration": {
      "title": "%iflow.configuration.title%",
      "properties": {
        "iflow.defaultMode": {
          "type": "string",
          "enum": [
            "smart",
            "yolo",
            "default",
            "plan"
          ],
          "default": "smart",
          "description": "%iflow.configuration.defaultMode.description%"
        },
        "iflow.nodePath": {
          "type": "string",
          "default": "",
          "description": "%iflow.configuration.nodePath.description%"
        },
        "iflow.warmStart": {
          "type": "boolean",
          "default": true,
          "description": "%iflow.configuration.warmStart.description%"
        },
        "iflow.soundFeedback": {
          "type": "boolean",
          "default": true,
          "description": "%iflow.configuration.soundFeedback.description%"
        },
        "iflow.auroraIntensity": {
          "type": "number",
          "default": 35,
          "minimum": 0,
          "maximum": 100,
          "description": "%iflow.configuration.auroraIntensity.description%"
        },
        "iflow.theme": {
          "type": "string",
          "enum": ["auto", "light", "dark"],
          "default": "auto",
          "description": "%iflow.configuration.theme.description%"
        },
        "iflow.uiFontSize": {
          "type": "string",
          "enum": [
            "compact",
            "standard",
            "large"
          ],
          "default": "standard",
          "description": "%iflow.configuration.uiFontSize.description%"
        },
        "iflow.uiDensity": {
          "type": "string",
          "enum": [
            "compact",
            "standard",
            "comfortable"
          ],
          "default": "standard",
          "description": "%iflow.configuration.uiDensity.description%"
        },
        "iflow.restoreLastSession": {
          "type": "boolean",
          "default": false,
          "description": "%iflow.configuration.restoreLastSession.description%"
        },
        "iflow.autoOpenPanel": {
          "type": "boolean",
          "default": false,
          "description": "%iflow.configuration.autoOpenPanel.description%"
        },
        "iflow.language": {
          "type": "string",
          "enum": [
            "",
            "zh-CN",
            "en-US"
          ],
          "default": "",
          "markdownDescription": "%iflow.configuration.language.description%"
        },
        "iflow.approvalMode": {
          "type": "string",
          "enum": [
            "",
            "default",
            "smart",
            "yolo",
            "plan"
          ],
          "default": "",
          "markdownDescription": "%iflow.configuration.approvalMode.description%"
        },
        "iflow.osNotifications": {
          "type": "string",
          "enum": [
            "off",
            "approvals",
            "all"
          ],
          "default": "approvals",
          "description": "%iflow.configuration.osNotifications.description%"
        },
        "iflow.contextWindowOverrides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%iflow.configuration.contextWindowOverrides.description%"
        },
        "iflow.costTable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%iflow.configuration.costTable.description%"
        },
        "iflow.thinkingModelRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Case-insensitive regex matched against model ids; first match wins"
              },
              "supportsThinking": {
                "type": "boolean",
                "description": "Whether the matched model supports thinking mode"
              },
              "supportedReasoningLevels": {
                "type": "array",
                "items": {
                  "enum": ["low", "medium", "high"]
                },
                "description": "Reasoning levels the model supports (default: low/medium/high)"
              },
              "maxThinkingTokens": {
                "type": "number",
                "description": "Thinking-token ceiling (0 = CLI default)"
              }
            },
            "required": ["pattern", "supportsThinking"]
          },
          "default": [
            {
              "pattern": "^o[134]",
              "supportsThinking": true,
              "supportedReasoningLevels": ["low", "medium", "high"]
            },
            {
              "pattern": "deepseek-(r1|reasoner)",
              "supportsThinking": true,
              "supportedReasoningLevels": ["low", "medium", "high"]
            },
            {
              "pattern": "gemini-[2-9]",
              "supportsThinking": true,
              "supportedReasoningLevels": ["low", "medium", "high"]
            },
            {
              "pattern": "^qwen3",
              "supportsThinking": true,
              "supportedReasoningLevels": ["low", "medium", "high"]
            },
            {
              "pattern": "kimi-k2\\.5",
              "supportsThinking": true,
              "supportedReasoningLevels": ["low", "medium", "high"]
            },
            {
              "pattern": "grok-[34]",
              "supportsThinking": true,
              "supportedReasoningLevels": ["low", "medium", "high"]
            }
          ],
          "description": "%iflow.configuration.thinkingModelRules.description%"
        },
        "iflow.autoTitle": {
          "type": "boolean",
          "default": true,
          "description": "%iflow.configuration.autoTitle.description%"
        },
        "iflow.nextStepSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "%iflow.configuration.nextStepSuggestions.description%"
        },
        "iflow.autoCompressOnIdle": {
          "type": "boolean",
          "default": false,
          "description": "%iflow.configuration.autoCompressOnIdle.description%"
        },
        "iflow.autoMemoryCapture": {
          "type": "boolean",
          "default": true,
          "description": "%iflow.configuration.autoMemoryCapture.description%"
        },
        "iflow.checkpoints": {
          "type": "boolean",
          "default": true,
          "description": "%iflow.configuration.checkpoints.description%"
        },
        "iflow.checkpointMaxFiles": {
          "type": "number",
          "default": 50000,
          "minimum": 1,
          "description": "%iflow.configuration.checkpointMaxFiles.description%"
        },
        "iflow.checkpointMaxFileMB": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "%iflow.configuration.checkpointMaxFileMB.description%"
        },
        "iflow.checkpointDir": {
          "type": "string",
          "default": "",
          "description": "%iflow.configuration.checkpointDir.description%"
        },
        "iflow.checkpointMaxTurns": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%iflow.configuration.checkpointMaxTurns.description%"
        },
        "iflow.checkpointMaxSizeMB": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%iflow.configuration.checkpointMaxSizeMB.description%"
        }
      }
    }
  },
  "scripts": {
    "icon": "node scripts/generate-icon.mjs",
    "build": "npm run icon && tsc -p tsconfig.json && node esbuild.mjs && vite build webview",
    "webview:dev": "vite build webview --watch",
    "typecheck": "npm run typecheck:host && npm run typecheck:webview",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:deps": "knip",
    "harness": "node scripts/harness.mjs",
    "probe:memory": "node test/fixtures/probe-memory.mjs",
    "vendor:cli": "node scripts/vendor-cli.mjs",
    "defaults:sync": "node scripts/vendor-cli.mjs --sync-defaults",
    "package": "npm run vendor:cli -- --force && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "knip": "^6.37.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "gpt-tokenizer": "^4.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.42.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "node-notifier": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
