{
  "name": "iflow-vscode",
  "displayName": "iFlow Agent",
  "description": "iFlow CLI graphical agent for VSCode (ACP-based)",
  "version": "0.1.0",
  "type": "module",
  "publisher": "iflow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.pandorastudio.cn/product/iFlow-harness.git"
  },
  "keywords": [
    "iflow",
    "ai",
    "agent",
    "acp",
    "chat"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iflow-chat",
          "title": "iFlow Agent",
          "icon": "media/iflow.svg"
        }
      ]
    },
    "views": {
      "iflow-chat": [
        {
          "type": "webview",
          "id": "iflow.chatPanel",
          "name": "Chat"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "iflow.agent",
        "name": "iflow",
        "fullName": "iFlow",
        "description": "向 iFlow 会话提问（纯文本通道，审批等富交互请在侧边栏面板）",
        "isSticky": true,
        "commands": []
      }
    ],
    "commands": [
      {
        "command": "iflow.openPanel",
        "title": "iFlow: Open Chat Panel",
        "category": "iFlow"
      },
      {
        "command": "iflow.newSession",
        "title": "iFlow: New Session",
        "category": "iFlow"
      },
      {
        "command": "iflow.askSelection",
        "title": "Ask iFlow",
        "category": "iFlow"
      },
      {
        "command": "iflow.addSelectionToContext",
        "title": "Add to iFlow Context",
        "category": "iFlow"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "iflow.askSelection",
          "when": "editorHasSelection",
          "group": "9_iflow"
        },
        {
          "command": "iflow.addSelectionToContext",
          "when": "editorHasSelection",
          "group": "9_iflow"
        }
      ]
    },
    "configuration": {
      "title": "iFlow Agent",
      "properties": {
        "iflow.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the iFlow CLI bundle entry.js (leave empty for auto-detection)"
        },
        "iflow.defaultMode": {
          "type": "string",
          "enum": [
            "smart",
            "yolo",
            "default",
            "plan"
          ],
          "default": "smart",
          "description": "Default permission mode for new sessions"
        },
        "iflow.nodePath": {
          "type": "string",
          "default": "",
          "description": "Custom Node.js executable used to spawn the CLI"
        },
        "iflow.idleTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "description": "Recycle the CLI process after this many idle minutes"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.mjs && vite build webview",
    "webview:dev": "vite build webview --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "harness": "node scripts/harness.mjs",
    "package": "npm run build && vsce package --no-dependencies --baseContentUrl https://git.pandorastudio.cn/product/iFlow-harness/raw/branch/master/ --baseImagesUrl https://git.pandorastudio.cn/product/iFlow-harness/raw/branch/master/"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
