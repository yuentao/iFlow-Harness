{
  "name": "iflow-vscode",
  "displayName": "iFlow Agent",
  "description": "iFlow CLI graphical agent for VSCode (ACP-based)",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "publisher": "iflow",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iflow-chat",
          "title": "iFlow Agent",
          "icon": "media/iflow.svg"
        }
      ]
    },
    "views": {
      "iflow-chat": [
        {
          "type": "webview",
          "id": "iflow.chatPanel",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "iflow.openPanel",
        "title": "iFlow: Open Chat Panel",
        "category": "iFlow"
      },
      {
        "command": "iflow.newSession",
        "title": "iFlow: New Session",
        "category": "iFlow"
      }
    ],
    "configuration": {
      "title": "iFlow Agent",
      "properties": {
        "iflow.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the iFlow CLI bundle entry.js (leave empty for auto-detection)"
        },
        "iflow.defaultMode": {
          "type": "string",
          "enum": [
            "smart",
            "yolo",
            "default",
            "plan"
          ],
          "default": "smart",
          "description": "Default permission mode for new sessions"
        },
        "iflow.nodePath": {
          "type": "string",
          "default": "",
          "description": "Custom Node.js executable used to spawn the CLI"
        },
        "iflow.idleTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "description": "Recycle the CLI process after this many idle minutes"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.mjs && vite build webview",
    "webview:dev": "vite build webview --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "harness": "node scripts/harness.mjs"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.136.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
