# Dependencies
node_modules/

# Build output
dist/
UI/
webview/dist/
# Generated vendored CLI artifacts (created by scripts/vendor-cli.mjs at package
# time). The committed in-repo fork snapshot below is the CI default source.
vendor/*
!vendor/iflow-fork/
!vendor/iflow-fork/**
# node_modules/ above matches at every depth; re-include the snapshot's deps.
!vendor/iflow-fork/node_modules/
!vendor/iflow-fork/node_modules/**

*.vsix

# VS Code extension test artifacts
.vscode-test/

# Test fixtures (generated recordings)
test/fixtures/*.ndjson
test/fixtures/*.json
test/fixtures/probe-memory-context.txt
# Panel tests write transcripts to their stub storageUri; never a fixture.
test/transcripts/

# UI verification screenshots (Playwright smoke runs, repo root only)
/*.jpg
/*.png

# Editor & OS files
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs & caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.vite/
coverage/

# Environment
.env
.env.local
.env.*.local
*.js.original
session-*.md