# Everything needed at runtime is bundled: dist/extension.cjs (esbuild),
# webview/dist/** (vite), media/, plus package.json / README / LICENSE.
.vscode/**
.github/**
src/**
test/**
docs/**
scripts/**
shared/**
UI/**
webview/src/**
webview/index.html
webview/vite.config.ts
webview/tsconfig.json
webview/preview*.log
tsconfig.json
tsconfig.test.json
vitest.config.ts
esbuild.mjs
.gitignore
# tsc emits intermediate output here; the host bundle is dist/extension.cjs.
dist/src/**
dist/shared/**
dist/acp/**
node_modules/**
# ...but the vendored CLI's runtime deps MUST ship (scripts/vendor-cli.mjs).
!vendor/iflow-cli/node_modules/**
*.vsix
m4-initial.jpg
iflow.js.original
session-*.md
