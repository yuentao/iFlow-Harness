# Everything needed at runtime is bundled: dist/extension.cjs (esbuild),
# webview/dist/** (vite), media/, plus package.json / README / LICENSE.
.vscode/**
.github/**
src/**
test/**
docs/**
# Workspace runtime data (knowledge index, .iflow/specs plans, approvals).
.iflow/**
scripts/**
shared/**
# Prompt templates are inlined into extension.cjs as text at build time (esbuild
# ".md": "text"), so nothing prompt-facing ships as a readable file. The CLI's
# IFLOW_SYSTEM_MD override is materialised into the extension's storage dir at runtime.
prompts/**
UI/**
webview/src/**
webview/index.html
webview/vite.config.ts
webview/tsconfig.json
webview/preview*.log
# Local debug entrypoints (webview:serve / webview:dev) drop stdout/stderr logs here.
webview/*.log
tsconfig.json
tsconfig.test.json
vitest.config.ts
knip.json
esbuild.mjs
.gitignore
# tsc emits intermediate output here; the host bundle is dist/extension.cjs.
dist/src/**
dist/shared/**
dist/acp/**
dist/prompts/**
# Sourcemaps embed the full TS sources (sourcesContent) — keep them local for F5.
dist/**/*.map
node_modules/**
# ...but the vendored CLI's runtime deps MUST ship (scripts/vendor-cli.mjs).
!vendor/iflow-cli/node_modules/**
*.vsix
m4-initial.jpg
iflow.js.original
session-*.md
AGENTS.md
