# Everything needed at runtime is bundled: dist/extension.cjs (esbuild),
# webview/dist/** (vite), media/, plus package.json / README / LICENSE.
.vscode/**
.github/**
src/**
test/**
docs/**
# Committed in-repo fork snapshot is source only. The generated vendor/iflow-cli
# copy (and its node_modules exception below) is what ships in the VSIX.
vendor/iflow-fork/
vendor/iflow-fork/**
# Workspace runtime data (knowledge index, .iflow/specs plans, approvals).
.iflow/**
scripts/**
shared/**
# Prompt templates are inlined into extension.cjs as text at build time (esbuild
# ".md": "text"), so nothing prompt-facing ships as a readable file. The CLI's
# IFLOW_SYSTEM_MD override is materialised into the extension's storage dir at runtime.
prompts/**
UI/**
webview/src/**
webview/index.html
webview/vite.config.ts
webview/tsconfig.json
webview/preview*.log
# Local debug entrypoints (webview:serve / webview:dev) drop stdout/stderr logs here.
webview/*.log
tsconfig.json
tsconfig.test.json
vitest.config.ts
knip.json
esbuild.mjs
.gitignore
# tsc emits intermediate output here; the host bundle is dist/extension.cjs.
dist/src/**
dist/shared/**
dist/acp/**
dist/prompts/**
# Sourcemaps embed the full TS sources (sourcesContent) — keep them local for F5.
dist/**/*.map
node_modules/**
# ...but the vendored CLI's runtime deps MUST ship (scripts/vendor-cli.mjs).
!vendor/iflow-cli/node_modules/**
*.vsix
m4-initial.jpg
iflow.js.original
session-*.md
# Local UI-verification screenshots (verify-*.png) are debug artifacts, not assets.
verify-*.png
# Internal agent/contributor notes: implementation details, local fork paths and
# credential-handling notes. Never ship it to the public Marketplace package.
AGENTS.md
# --- Internal planning docs, research notes & throwaway debug scripts --------
# Workspace-only artifacts. The five product/market planning reports are listed
# by exact name on purpose: a blanket *.md would also drop README.md /
# CHANGELOG.md / LICENSE, which the Marketplace page and the extension need.
#
# NOTE: vsce matches .vscodeignore with minimatch, NOT gitignore semantics —
# a leading "/" is a literal separator there, not a root anchor, so "/foo.md"
# never matches the relative path "foo.md". Patterns containing a "/" are
# anchored at the extension root; patterns without one match the file name.
本地产品与代码库分析报告.md
产品升级路线规划报告.md
市场现状与趋势提炼报告.md
未来市场预测报告.md
用户需求与技术趋势分析报告.md
research/**
# Throwaway root-level probe/verify scripts. They import dist/src/** (excluded
# above), so they can never run from a packaged install anyway.
.tmp-dump.mjs
.tmp-locate.mjs
.tmp-probe-window.mjs
.tmp-verify-window.mjs
verify-mcp.mjs
# Local tool ignore file — same category as .gitignore above.
.iflowignore
